rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (
          (request.auth.token.role == 'admin') ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    // Domain validator for codeProjects
    function isValidCodeProject(data) {
      return data.keys().hasOnly([
               'id', 'uid', 'title', 'language', 'mode', 'files', 
               'stdin', 'lessonId', 'courseId', 'createdAt', 'updatedAt'
             ]) &&
             data.uid is string &&
             data.uid == request.auth.uid &&
             (!('title' in data) || (data.title is string && data.title.size() <= 200)) &&
             (!('language' in data) || (data.language is string && data.language.size() <= 50)) &&
             (!('mode' in data) || (data.mode is string && data.mode.size() <= 50)) &&
             (!('files' in data) || (data.files is map && data.files.keys().size() <= 20)) &&
             (!('stdin' in data) || data.stdin == null || (data.stdin is string && data.stdin.size() <= 100000)) &&
             (!('lessonId' in data) || data.lessonId == null || (data.lessonId is string && data.lessonId.size() <= 128)) &&
             (!('courseId' in data) || data.courseId == null || (data.courseId is string && data.courseId.size() <= 128)) &&
             (!('id' in data) || data.id == null || (data.id is string && data.id.size() <= 128)) &&
             (!('createdAt' in data) || data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Users collection
    // - Authenticated users can read their own profile, or admins can read all
    // - Users can create their own profile during signup with role 'student' (cannot elevate to admin)
    // - Users can update profile details, but CANNOT change their own role
    // - Only admins can update user role or delete users
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && 
                      request.resource.data.uid == userId && 
                      (request.resource.data.role == 'student' || (!('role' in request.resource.data)));
      allow update: if (isOwner(userId) && 
                        request.resource.data.role == resource.data.role) || 
                       isAdmin();
      allow delete: if isAdmin();
    }

    // Courses collection
    // - Authenticated users can read published courses; admins can read all
    // - Only admins can create, update, or delete courses
    match /courses/{courseId} {
      allow read: if isAuthenticated() && (resource.data.published == true || isAdmin());
      allow write: if isAdmin();
    }

    // Modules collection
    // - Authenticated users can read modules; admins can manage
    match /modules/{moduleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Lessons collection
    // - Authenticated users can read published lessons; admins can read all
    match /lessons/{lessonId} {
      allow read: if isAuthenticated() && (resource.data.published == true || isAdmin());
      allow write: if isAdmin();
    }

    // User Progress collection
    // - Students can read, create, and update only their own progress records
    // - Admins can read student progress for tracking and reporting
    match /userProgress/{progressId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && 
                       resource.data.uid == request.auth.uid && 
                       request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // User Notes collection
    // - Strictly private to each student: only the owner can read or write their notes
    match /userNotes/{noteId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && 
                       resource.data.uid == request.auth.uid && 
                       request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Lesson Activity collection
    match /lessonActivity/{activityId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && 
                       resource.data.uid == request.auth.uid && 
                       request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Events collection
    match /events/{eventId} {
      allow read: if isAuthenticated() && (resource.data.published == true || isAdmin());
      allow write: if isAdmin();
    }

    // Code Projects collection
    // - Authenticated students can read, create, update, and delete only their own code projects
    // - On create and update, ownership is strictly enforced to request.auth.uid
    // - Admins can read or delete code projects if needed
    match /codeProjects/{projectId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && 
                       request.resource.data.uid == request.auth.uid &&
                       isValidCodeProject(request.resource.data);
      allow update: if isAuthenticated() && 
                       resource.data.uid == request.auth.uid && 
                       request.resource.data.uid == request.auth.uid &&
                       isValidCodeProject(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }
  }
}
